# Copy to .env for local development. Never commit .env.
# Development: a local SQLite file. Production: your Turso database URL (libsql://...).
TURSO_DATABASE_URL=file:./data/dev.db
# Empty for a local file; a Turso database token in production.
TURSO_AUTH_TOKEN=
# At least 32 random characters: openssl rand -base64 48
SITE_SECRET=
