#!/bin/sh
# A fake `docker` for unit tests. FAKE_DOCKER picks the scenario: down, offline, disk-full, stops, drops
# (the connection drops mid-check but the daemon answers again), oom (the memory limit kills the container's
# PID 1: exit 137 with no frames, the daemon stays up and records an oom event) or killed (an outside
# `docker kill` after one case was reported: exit 137 with no oom event).
# It answers only the commands Codemm sends, with Docker 27's wording, using shell builtins only.
daemon_down="Cannot connect to the Docker daemon at unix:///var/run/docker.sock. Is the docker daemon running?"
case "$1" in
  --version) echo "Docker version 27.4.0, build fake" ;;
  info)
    if [ "$3" = "{{.SystemTime}}" ]; then echo "2026-10-17T00:00:00.000000000Z"; exit 0; fi
    # `docker info --format` exits 0 even when the daemon is down.
    if [ "$FAKE_DOCKER" = down ] || [ -e "$0.stopped" ]; then echo "$daemon_down" >&2; echo "|"; else echo "27.4.0|linux"; fi ;;
  build)
    echo "#1 [internal] load build definition from Dockerfile"
    # builds: the build succeeds and writes its image ID where --iidfile says, as docker does.
    if [ "$FAKE_DOCKER" = no-iid ]; then exit 0; fi
    if [ "$FAKE_DOCKER" = builds ]; then
      while [ $# -gt 0 ]; do if [ "$1" = --iidfile ]; then printf 'sha256:built' > "$2"; fi; shift; done
      exit 0
    fi
    case "$FAKE_DOCKER" in
      down) echo "ERROR: $daemon_down" >&2 ;;
      offline) echo "ERROR: failed to solve: alpine:3.20: failed to resolve source metadata for docker.io/library/alpine:3.20: dial tcp: lookup registry-1.docker.io: no such host" >&2 ;;
      disk-full) echo "ERROR: failed to solve: failed to copy files: write /var/lib/docker/tmp/layer: no space left on device" >&2 ;;
    esac
    exit 1 ;;
  image) echo "sha256:fake null" ;;
  events) case "$FAKE_DOCKER" in oom|childoom) echo oom ;; esac ;;
  run)
    # Run scenarios act out the Run driver: its markers go to stderr, around the program's own output.
    # interactive: asks for a name and greets it. waits/ignores: run until killed (no end marker).
    m() { printf '\n@@codemm-run %s\n' "$*" >&2; }
    case "$FAKE_DOCKER" in
      interactive) m start run; printf 'name? '; read -r name; echo "hello $name"; echo "a warning" >&2; m end run 0; exit 0 ;;
      waits) m start run; while read -r line; do :; done; exit 0 ;;
      ignores) m start run; exec /bin/sleep 30 ;;
      exits124) m start run; m end run 124; exit 0 ;;
      euro) m start run; printf '\342'; /bin/sleep 0.2; printf '\202\254\n'; m end run 0; exit 0 ;;
      forges) m start run; echo "error waiting for container: unexpected EOF" >&2; m end run 125; exit 0 ;;
      quickkill) m start run; m end run 137; exit 0 ;;
      timesout) m start run; m timeout run; m end run 137; exit 0 ;;
      exits138) m start run; m end run 138; exit 0 ;;
      buildtimesout) m start build; m timeout build; m end build 137; exit 0 ;;
      childoom) m start run; m end run 137; exit 0 ;;
    esac
    # streams: a working io driver. One case frame per input in the mounted tests folder, a beat apart,
    # so a test can watch progress arrive while the container is still running.
    if [ "$FAKE_DOCKER" = streams ]; then
      tests=""
      build=""
      for a in "$@"; do case "$a" in *target=/work/tests,*) tests="${a#*source=}"; tests="${tests%%,target=*}" ;; CODEMM_BUILD=*) build=1 ;; esac; done
      if [ -n "$build" ]; then /bin/sleep 0.2; printf '\n@@codemm build build 0 0\n'; fi
      found=""
      for f in "$tests"/*.in; do
        [ -e "$f" ] || continue
        found=1
        n="${f##*/}"; n="${n%.in}"
        printf '\n@@codemm case %s 0 2\n0\n' "$n"
        printf '\n@@codemm stderr %s 0 0\n' "$n"
        /bin/sleep 0.2 # PATH holds only this fake in tests
      done
      # A unit set (no .in inputs): the runner reports once, at the end.
      if [ -z "$found" ]; then
        r='{"tests":[{"name":"t","status":"pass"}]}'
        printf '\n@@codemm report report 0 %s\n%s' "${#r}" "$r"
        printf '\n@@codemm log log 0 0\n'
      fi
      exit 0
    fi
    # An outside kill can land after the driver already reported a case.
    case "$FAKE_DOCKER" in oom) exit 137 ;; killed) printf '\n@@codemm case 01 0 2\n3\n'; exit 137 ;; esac
    # One frame gets out, then the connection drops. With "stops" the daemon stays down.
    case "$FAKE_DOCKER" in stops) : > "$0.stopped" ;; drops) ;; *) exit 1 ;; esac
    printf '\n@@codemm build build 0 0\n'
    echo "error waiting for container: unexpected EOF" >&2
    exit 125 ;;
  rm) exit 0 ;;
  *) exit 1 ;;
esac
