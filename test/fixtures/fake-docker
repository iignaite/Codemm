#!/bin/sh
# A fake `docker` for unit tests. FAKE_DOCKER picks the scenario: down, offline, disk-full, stops, drops
# (the connection drops mid-check but the daemon answers again), oom (the memory limit kills the container's
# PID 1: exit 137 with no frames, the daemon stays up and records an oom event) or killed (the same exit from
# an outside `docker kill`, with no oom event).
# It answers only the commands Codemm sends, with Docker 27's wording, using shell builtins only.
daemon_down="Cannot connect to the Docker daemon at unix:///var/run/docker.sock. Is the docker daemon running?"
case "$1" in
  --version) echo "Docker version 27.4.0, build fake" ;;
  info)
    # `docker info --format` exits 0 even when the daemon is down.
    if [ "$FAKE_DOCKER" = down ] || [ -e "$0.stopped" ]; then echo "$daemon_down" >&2; echo "|"; else echo "27.4.0|linux"; fi ;;
  build)
    echo "#1 [internal] load build definition from Dockerfile"
    case "$FAKE_DOCKER" in
      down) echo "ERROR: $daemon_down" >&2 ;;
      offline) echo "ERROR: failed to solve: alpine:3.20: failed to resolve source metadata for docker.io/library/alpine:3.20: dial tcp: lookup registry-1.docker.io: no such host" >&2 ;;
      disk-full) echo "ERROR: failed to solve: failed to copy files: write /var/lib/docker/tmp/layer: no space left on device" >&2 ;;
    esac
    exit 1 ;;
  image) echo "sha256:fake null" ;;
  events) if [ "$FAKE_DOCKER" = oom ]; then echo oom; fi ;;
  run)
    case "$FAKE_DOCKER" in oom|killed) exit 137 ;; esac
    # One frame gets out, then the connection drops. With "stops" the daemon stays down.
    case "$FAKE_DOCKER" in stops) : > "$0.stopped" ;; drops) ;; *) exit 1 ;; esac
    printf '\n@@codemm build build 0 0\n'
    echo "error waiting for container: unexpected EOF" >&2
    exit 125 ;;
  *) exit 1 ;;
esac
