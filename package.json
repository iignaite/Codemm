{
  "name": "codemm",
  "version": "1.0.0-beta.7",
  "description": "Open-source harness for graded coding practice: your coding agent writes the tracks and exercises, Codemm verifies, grades and tracks mastery.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "codemm": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --exclude 'test/docker/**'",
    "test:docker": "vitest run test/docker",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "markdown-it": "^14.3.3",
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
