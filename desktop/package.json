{
  "name": "codemm-desktop",
  "productName": "Codemm",
  "version": "1.0.0-beta.7",
  "private": true,
  "description": "Codemm desktop app",
  "license": "MIT",
  "author": "Codemm contributors",
  "homepage": "https://github.com/iignaite/Codemm",
  "main": "out/main/boot.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "build": "vite build && tsc -p tsconfig.node.json && node scripts/bundle-core.mjs",
    "start": "npm run build && electron .",
    "test:e2e": "npm run build && playwright test e2e/smoke.spec.ts e2e/a11y.spec.ts",
    "dist": "npm run build && node scripts/fetch-wasmtime.mjs && electron-builder --config electron-builder.config.cjs --publish never",
    "test:packaged": "playwright test e2e/packaged.spec.ts e2e/artifact.spec.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electron/asar": "^3.4.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "~6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.17.0",
    "esbuild": "^0.28.2",
    "highlight.js": "11.12.0",
    "jsdom": "^26.1.0",
    "markdown-it": "^14.3.3",
    "mermaid": "12.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "electron-updater": "6.8.10"
  }
}
