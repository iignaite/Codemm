{
  "name": "codemm-desktop",
  "productName": "Codemm",
  "version": "0.1.0",
  "private": true,
  "description": "Codemm desktop app",
  "license": "MIT",
  "author": "Codemm contributors <noreply@codemm.dev>",
  "homepage": "https://github.com/iignaite/Codemm",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
